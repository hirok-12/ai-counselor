{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-counselor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-counselor-db",
      "database_id": "590a243f-c4c4-4b11-9d41-181bf46796ef"
    }
  ]
  // ANTHROPIC_API_KEY は秘密情報なのでここには書かない:
  //   ローカル: .dev.vars に記載
  //   本番:     npx wrangler secret put ANTHROPIC_API_KEY
}
